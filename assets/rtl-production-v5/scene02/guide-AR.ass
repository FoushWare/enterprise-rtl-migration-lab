Dialogue: 0,00:00:00.25,00:00:05.75,Guide,,0,0,0,,‫دي نسخة الـ‪Study‬. بنشغّل التطبيق الحقيقي من الـ‪Terminal‬.‬
Dialogue: 0,00:00:06.25,00:00:13.75,Guide,,0,0,0,,‫الواجهة شغّالة بالإنجليزي. نبدّل للعربي من نفس اختيار اللغة.‬
Dialogue: 0,00:00:14.25,00:00:21.75,Guide,,0,0,0,,‫العربي اتفعّل، لكن الـ‪Sidebar‬ فضل على الشمال.‬
Dialogue: 0,00:00:22.25,00:00:23.75,Guide,,0,0,0,,‫الـ‪Logo‬ بالإنجليزي.‬
Dialogue: 0,00:00:24.25,00:00:30.75,Guide,,0,0,0,,‫بالعربي، تركيب الـ‪Logo‬ اتقلب والنقطة اتحركت قبل الاسم.‬
Dialogue: 0,00:00:31.25,00:00:38.75,Guide,,0,0,0,,‫هنا أيقونة الـ‪KPI‬ داخلة على عنوان الكارت.‬
Dialogue: 0,00:00:39.25,00:00:46.75,Guide,,0,0,0,,{\an8\pos(1120,120)}‫ترتيب الشهور انعكس، لكن مسار الرسم نفسه ما اتغيرش.‬
Dialogue: 0,00:00:47.25,00:00:48.75,Guide,,0,0,0,,‫سهم التفاصيل بالإنجليزي.‬
Dialogue: 0,00:00:49.25,00:00:55.75,Guide,,0,0,0,,‫السهم اتحرك للشمال، لكنه لسه بيشاور لليمين.‬
Dialogue: 0,00:00:56.25,00:00:59.75,Guide,,0,0,0,,‫الفاتورة بتتفتح صح؛ المشكلة اتجاه السهم.‬
Dialogue: 0,00:01:00.25,00:01:06.75,Guide,,0,0,0,,{\an8\pos(1120,120)}‫الصفحات بتتغيّر صح، لكن سهم التالي مش متوافق مع ترتيبها بالعربي.‬
Dialogue: 0,00:01:07.25,00:01:11.75,Guide,,0,0,0,,‫نفتح نموذج إنشاء فاتورة الحقيقي.‬
Dialogue: 0,00:01:12.25,00:01:20.75,Guide,,0,0,0,,‫عناوين الحقول لسه متظبطة على الشمال، رغم إن الواجهة عربي.‬
Dialogue: 0,00:01:21.25,00:01:24.75,Guide,,0,0,0,,‫ودي بيانات العملاء التجريبية.‬
Dialogue: 0,00:01:25.25,00:01:32.75,Guide,,0,0,0,,‫جوه الـ‪Dialog‬، زرار القفل داخل على عنوان العميل.‬
Dialogue: 0,00:01:33.25,00:01:40.75,Guide,,0,0,0,,‫نفس العنوان الإنجليزي، لكن رقم أربعة وعشرين ظهر في آخره.‬
Dialogue: 0,00:01:41.25,00:01:54.75,Guide,,0,0,0,,‫نروح للمشتريات، ونبدّل اللغة من الاختيار الحقيقي.‬
Dialogue: 0,00:01:55.25,00:02:01.75,Guide,,0,0,0,,‫عناوين الجدول العربي لسه على الشمال جوه الأعمدة.‬
Dialogue: 0,00:02:02.25,00:02:08.75,Guide,,0,0,0,,‫ونفس مشكلة المحاذاة ظاهرة في عنوان فلتر الحالة.‬
Dialogue: 0,00:02:09.25,00:02:13.75,Guide,,0,0,0,,‫البيانات ثابتة. الجاي نفهم طبقات الكود.‬
