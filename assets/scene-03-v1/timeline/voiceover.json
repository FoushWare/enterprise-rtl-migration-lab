  "EN": [
    {
      "start": 0.3,
      "end": 3.0647058823529405,
      "text": "Let’s look under the hood.",
      "shot": "03-01",
      "estimated_only": true
    },
    {
      "start": 3.0647058823529405,
      "end": 9.7,
      "text": "Before changing code, identify the main components and who owns each responsibility.",
      "shot": "03-01",
      "estimated_only": true
    },
    {
      "start": 10.3,
      "end": 15.522222222222222,
      "text": "This Nx monorepo contains two applications, shared libraries, and tools.",
      "shot": "03-02",
      "estimated_only": true
    },
    {
      "start": 15.522222222222222,
      "end": 19.7,
      "text": "Separate application logic, shared presentation, and source analysis.",
      "shot": "03-02",
      "estimated_only": true
    },
    {
      "start": 20.3,
      "end": 27.2,
      "text": "Invoicing manages invoices, with its own entry point, routes, list, and detail pages.",
      "shot": "03-03",
      "estimated_only": true
    },
    {
      "start": 27.6,
      "end": 32.333333333333336,
      "text": "Procurement manages purchase orders through its own entry and routes.",
      "shot": "03-03",
      "estimated_only": true
    },
    {
      "start": 32.333333333333336,
      "end": 34.7,
      "text": "Both applications use shared libraries.",
      "shot": "03-03",
      "estimated_only": true
    },
    {
      "start": 35.3,
      "end": 37.75217391304348,
      "text": "This is the real Invoicing App.",
      "shot": "03-04",
      "estimated_only": true
    },
    {
      "start": 37.75217391304348,
      "end": 44.7,
      "text": "The router selects pages; App owns invoice state and passes it to the pages that need it.",
      "shot": "03-04",
      "estimated_only": true
    },
    {
      "start": 45.3,
      "end": 50.522222222222226,
      "text": "The Design System supplies the shell, fields, tables, and dialogs.",
      "shot": "03-05",
      "estimated_only": true
    },
    {
      "start": 50.522222222222226,
      "end": 54.7,
      "text": "One shared component can therefore affect both applications.",
      "shot": "03-05",
      "estimated_only": true
    },
    {
      "start": 55.3,
      "end": 60.742105263157896,
      "text": "Shared contains business types, fixtures, totals, money formatting, and local storage.",
      "shot": "03-06",
      "estimated_only": true
    },
    {
      "start": 60.742105263157896,
      "end": 64.7,
      "text": "It also exports the locale and translation interface.",
      "shot": "03-06",
      "estimated_only": true
    },
    {
      "start": 65.3,
      "end": 68.97826086956522,
      "text": "Locale, document direction, styling, and icon meaning are separate.",
      "shot": "03-07",
      "estimated_only": true
    },
    {
      "start": 68.97826086956522,
      "end": 74.7,
      "text": "Study uses document RTL and MUI LTR; icons require semantic review, not automatic mirroring.",
      "shot": "03-07",
      "estimated_only": true
    },
    {
      "start": 75.3,
      "end": 78.71818181818182,
      "text": "The Scanner collects static evidence and potential risks.",
      "shot": "03-08",
      "estimated_only": true
    },
    {
      "start": 78.71818181818182,
      "end": 84.7,
      "text": "The Codemod constrains changes through safety checks; a finding is not automatic repair approval.",
      "shot": "03-08",
      "estimated_only": true
    },
    {
      "start": 85.3,
      "end": 89.22727272727272,
      "text": "These relationships come from actual imports.",
      "shot": "03-09",
      "estimated_only": true
    },
    {
      "start": 89.22727272727272,
      "end": 93.8090909090909,
      "text": "Both applications use Design System and Shared.",
      "shot": "03-09",
      "estimated_only": true
    },
    {
      "start": 93.8090909090909,
      "end": 99.7,
      "text": "Tools analyze source files; neither application imports the other.",
      "shot": "03-09",
      "estimated_only": true
    },
    {
      "start": 100.3,
      "end": 109.06521739130434,
      "text": "Our real example is invoice1048: Northstar Studio, four thousand eight hundred US dollars, Pending.",
      "shot": "03-10",
      "estimated_only": true
    },
    {
      "start": 109.06521739130434,
      "end": 114.7,
      "text": "The actual table link opens the same invoice details.",
      "shot": "03-10",
      "estimated_only": true
    },
    {
      "start": 115.3,
      "end": 122.56363636363636,
      "text": "A symptom may appear in an application while its owner is a shared component or runtime layer.",
      "shot": "03-11",
      "estimated_only": true
    },
    {
      "start": 122.56363636363636,
      "end": 124.7,
      "text": "Establish causality before changing code.",
      "shot": "03-11",
      "estimated_only": true
    },
    {
      "start": 125.3,
      "end": 129.7,
      "text": "How do we find RTL risks across this codebase?",
      "shot": "03-12",
      "estimated_only": true
    }
  ]
}