{
  "name": "atlas-invoice",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "nx run invoicing:dev",
    "dev:procurement": "nx run procurement:dev",
    "build": "nx run-many -t build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --grep visual",
    "storybook": "storybook dev -p 6006",
    "rtl:scan": "node dist/tools/rtl-scanner/cli.js",
    "rtl:scan:test": "vitest run --config tools/rtl-scanner/vitest.config.ts",
    "rtl:scan:typecheck": "tsc -p tools/rtl-scanner/tsconfig.typecheck.json",
    "rtl:scan:build": "tsc -p tools/rtl-scanner/tsconfig.json"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.0",
    "@mui/material": "^7.3.0",
    "@mui/stylis-plugin-rtl": "7.3.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "stylis": "4.2.0"
  },
  "devDependencies": {
    "@nx/vite": "23.3.0",
    "@playwright/test": "^1.56.0",
    "@storybook/react-vite": "10.6.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.0.0",
    "jsdom": "^26.0.0",
    "nx": "23.3.0",
    "parse5": "7.3.0",
    "postcss": "8.5.29",
    "postcss-value-parser": "4.2.0",
    "storybook": "10.6.1",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "5.0.3"
  },
  "overrides": {
    "undici": "^7.29.1"
  },
  "type": "module"
}
