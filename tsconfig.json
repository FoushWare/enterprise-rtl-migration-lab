{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@atlas/design-system": ["libs/design-system/src/index.tsx"],
      "@atlas/shared": ["libs/shared/src/index.ts"]
    },
    "types": ["vite/client", "node"]
  },
  "include": ["apps", "libs", "tests", "*.ts", ".storybook"]
}
